{
    "name": "opencoursematch/opencoursematch",
    "description": "OpenCourseMatch is an open-source web application designed to automate the assignment of participants to courses depending on the participants' preferences and the courses' requirements.",
    "version": "dev-latest",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",

        "struktal/struktal-core": "^1.0.4",

        "parsedown/parsedown": "~1.8.0",
        "dompdf/dompdf": "^3.0",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "struktal/struktal-dev-core": "^1.1.0"
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "struktal\\core\\StruktalDevCoreInitializer::installPlaywrightDependencies"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f docker-compose-dev.yml up --build"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "struktal\\devcore\\StruktalTestCommand"
        ]
    }
}
